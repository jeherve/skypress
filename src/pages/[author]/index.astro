---
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
import { resolveAuthor } from '../../lib/reader/identity';
import { listAllReaderPublications } from '../../lib/reader/publications';
import { fetchActorProfile } from '../../lib/reader/profile';
import { buildGetBlobUrl } from '../../lib/media/blob';
import CreatePublicationCta from '../../components/CreatePublicationCta.tsx';
import ErrorScene from '../../components/ErrorScene.astro';
import { errorScene } from '../../lib/reader/errors';
import type { ErrorSceneCopy } from '../../lib/reader/errors';

export const prerender = false;

const { author } = Astro.params;

let error: ErrorSceneCopy | null = null;
const handle = author?.startsWith( '@' ) ? author.slice( 1 ) : '';

let did = '';
let pdsUrl = '';
let profile: Awaited< ReturnType< typeof fetchActorProfile > > | null = null;
let publications: Awaited< ReturnType< typeof listAllReaderPublications > >[ 'owned' ] = [];
let foreign: Awaited< ReturnType< typeof listAllReaderPublications > >[ 'foreign' ] = [];
let authorName = '';
let initial = '';

if ( ! author || ! author.startsWith( '@' ) ) {
	error = errorScene( 'not-found' );
}

const resolved = error ? null : await resolveAuthor( handle );
if ( ! error && ! resolved ) {
	error = errorScene( 'writer-not-found', { handle } );
}

if ( ! error && resolved ) {
	did = resolved.did;
	pdsUrl = resolved.pdsUrl;

	const [ fetchedProfile, allPublications ] = await Promise.all( [
		fetchActorProfile( pdsUrl, did ),
		listAllReaderPublications( pdsUrl, did ),
	] );
	profile = fetchedProfile;
	publications = allPublications.owned;
	foreign = allPublications.foreign;

	authorName = profile.displayName ?? `@${ handle }`;
	initial = authorName.replace( /^@/, '' ).charAt( 0 ).toUpperCase();
}

if ( error ) {
	Astro.response.status = error.status;
}
---

{
	error ? (
		<ErrorScene eyebrow={error.eyebrow} heading={error.heading} subline={error.subline} />
	) : (
		<Base title={`${ authorName } — SkyPress`} description={profile!.description ?? undefined}>
			<header class="masthead">
				<a href="/"><Logo /></a>
			</header>

			<main class="author">
				<div class="author__hero">
					{profile!.banner && (
						<div class="author__cover" style={`background-image:url("${ profile!.banner }")`} aria-hidden="true"></div>
					)}
					<div class={`author__identity${ profile!.banner ? ' author__identity--overlap' : '' }`}>
						{profile!.avatar ? (
							<img class="author__avatar" src={profile!.avatar} alt="" width="96" height="96" />
						) : (
							<span class="author__avatar author__avatar--fallback" aria-hidden="true">{initial}</span>
						)}
						<h1 class="author__name">{authorName}</h1>
						<p class="author__handle">
							<a
								class="author__handle-link"
								href={`https://bsky.app/profile/${ handle }`}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={`View @${ handle } on Bluesky`}
							>
								<svg
									class="author__handle-logo"
									width="12"
									height="11"
									viewBox="0 0 568 501"
									fill="currentColor"
									aria-hidden="true"
								>
									<path d="M123.121 33.664C188.241 82.553 258.281 181.68 284 234.873c25.719-53.192 95.759-152.32 160.879-201.21C491.866-1.611 568-28.906 568 57.947c0 17.346-9.945 145.713-15.778 166.555-20.275 72.453-94.155 90.933-159.875 79.748C507.222 323.8 536.444 388.56 473.333 453.32c-119.86 122.992-172.272-30.859-185.702-70.281-2.462-7.227-3.614-10.608-3.631-7.733-.017-2.875-1.169.506-3.631 7.733-13.43 39.422-65.842 193.273-185.702 70.281-63.111-64.76-33.89-129.52 80.986-149.071-65.72 11.185-139.6-7.295-159.875-79.748C9.945 203.66 0 75.293 0 57.947 0-28.906 76.135-1.611 123.121 33.664Z" />
								</svg>
								@{handle}
								<svg
									class="author__handle-arrow"
									width="11"
									height="11"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2.5"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d="M7 17 17 7" />
									<path d="M8 7h9v9" />
								</svg>
							</a>
						</p>
						{profile!.description && <p class="author__bio">{profile!.description}</p>}
					</div>
				</div>

				<h2 class="author__heading">Publications</h2>
				{publications.length === 0 ? (
					<div class="author__emptyblock">
						<p class="author__empty">No SkyPress publications yet.</p>
						<CreatePublicationCta client:only="react" profileDid={did} />
					</div>
				) : (
					<ul class="author__list">
						{publications.map( ( pub ) => {
							const logoUrl = pub.icon
								? buildGetBlobUrl( pdsUrl, did, pub.icon.ref.$link )
								: null;
							return (
								<li class="author__item">
									<a class="author__pub" href={`/@${ handle }/${ pub.slug }`}>
										{logoUrl ? (
											<img class="author__publogo" src={logoUrl} alt="" width="52" height="52" />
										) : (
											<span class="author__publogo author__publogo--fallback" aria-hidden="true">
												{pub.name.charAt( 0 ).toUpperCase()}
											</span>
										)}
										<span class="author__pubtext">
											<span class="author__pubname">{pub.name}</span>
											{pub.description && <span class="author__pubdesc">{pub.description}</span>}
										</span>
									</a>
								</li>
							);
						} )}
					</ul>
				)}

				{foreign.length > 0 && (
					<section class="author__elsewhere">
						<h2 class="author__heading">Elsewhere</h2>
						<ul class="author__list">
							{foreign.map( ( pub ) => {
								const logoUrl = pub.icon
									? buildGetBlobUrl( pdsUrl, did, pub.icon.ref.$link )
									: null;
								return (
									<li class="author__item">
										<a
											class="author__pub author__pub--external"
											href={pub.url}
											target="_blank"
											rel="noopener noreferrer"
										>
											{logoUrl ? (
												<img class="author__publogo" src={logoUrl} alt="" width="52" height="52" />
											) : (
												<span class="author__publogo author__publogo--fallback" aria-hidden="true">
													{pub.name.charAt( 0 ).toUpperCase()}
												</span>
											)}
											<span class="author__pubtext">
												<span class="author__pubname">{pub.name}</span>
											</span>
											<svg
												class="author__pub-arrow"
												width="13"
												height="13"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2.5"
												stroke-linecap="round"
												stroke-linejoin="round"
												aria-hidden="true"
											>
												<path d="M7 17 17 7" />
												<path d="M8 7h9v9" />
											</svg>
										</a>
									</li>
								);
							} )}
						</ul>
					</section>
				)}
			</main>
		</Base>
	)
}

<style>
	.masthead {
		padding: 1.5rem clamp(1.25rem, 5vw, 4rem);
		border-bottom: 1px solid var(--line);
	}
	.masthead a {
		text-decoration: none;
	}
	.author {
		max-width: 44rem;
		margin: 0 auto;
		padding: 0 1.5rem 6rem;
	}
	.author__hero {
		margin: 0 0 2rem;
	}
	.author__cover {
		height: clamp(8rem, 26vw, 14rem);
		margin: 0 calc(-1 * clamp(1.5rem, 5vw, 4rem));
		background-size: cover;
		background-position: center;
		border-bottom: 1px solid var(--line);
	}
	.author__identity {
		text-align: center;
		padding-top: 2.5rem;
	}
	.author__identity--overlap {
		margin-top: -3.5rem;
	}
	.author__avatar {
		width: 96px;
		height: 96px;
		border-radius: 50%;
		object-fit: cover;
		border: 3px solid var(--paper);
		box-shadow: var(--shadow);
		background: var(--paper-raised);
	}
	.author__avatar--fallback {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-display);
		font-size: 2.6rem;
		font-weight: 700;
		color: var(--sun);
		background: var(--sun-tint);
	}
	.author__name {
		font-size: clamp(2rem, 5.5vw, 3rem);
		margin: 0.75rem 0 0.1rem;
	}
	.author__handle {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.85rem;
		margin: 0;
	}
	.author__handle-link {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		color: inherit;
		text-decoration: none;
		transition: color 0.15s ease;
	}
	.author__handle-link:hover,
	.author__handle-link:focus-visible {
		color: var(--sun);
	}
	.author__handle-logo {
		opacity: 0;
		transform: translateX(4px);
		transition:
			opacity 0.15s ease,
			transform 0.15s ease;
	}
	.author__handle-link:hover .author__handle-logo,
	.author__handle-link:focus-visible .author__handle-logo {
		opacity: 1;
		transform: translateX(0);
	}
	.author__handle-arrow {
		opacity: 0;
		transform: translate(-2px, 2px);
		transition:
			opacity 0.15s ease,
			transform 0.15s ease;
	}
	.author__handle-link:hover .author__handle-arrow,
	.author__handle-link:focus-visible .author__handle-arrow {
		opacity: 1;
		transform: translate(0, 0);
	}
	.author__bio {
		color: var(--ink-soft);
		max-width: 46ch;
		margin: 1rem auto 0;
	}
	.author__heading {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--muted);
		margin: 0 0 0.75rem;
	}
	.author__empty {
		color: var(--muted);
	}
	.author__emptyblock {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
	}
	.author__list {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.author__item {
		border-top: 1px solid var(--line);
	}
	.author__pub {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1.1rem 0;
		text-decoration: none;
		color: var(--ink);
	}
	.author__publogo {
		width: 52px;
		height: 52px;
		border-radius: 12px;
		object-fit: cover;
		flex: none;
		background: var(--paper-raised);
	}
	.author__publogo--fallback {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.4rem;
		color: var(--sun);
		background: var(--sun-tint);
	}
	.author__pubtext {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.author__pubname {
		font-family: var(--font-display);
		font-size: 1.3rem;
		font-weight: 560;
	}
	.author__pub:hover .author__pubname {
		color: var(--sun);
	}
	.author__pubdesc {
		color: var(--ink-soft);
		font-size: 0.95rem;
	}
	.author__elsewhere {
		margin-top: 2.5rem;
	}
	.author__pub--external {
		justify-content: flex-start;
	}
	.author__pub-arrow {
		margin-left: auto;
		flex: none;
		color: var(--muted);
		opacity: 0;
		transform: translate(-2px, 2px);
		transition:
			opacity 0.15s ease,
			transform 0.15s ease,
			color 0.15s ease;
	}
	.author__pub--external:hover .author__pub-arrow,
	.author__pub--external:focus-visible .author__pub-arrow {
		opacity: 1;
		transform: translate(0, 0);
		color: var(--sun);
	}
</style>
