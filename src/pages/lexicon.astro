---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Footer from '../components/Footer.astro';
import {
	CONTENT_LEXICON,
	CONTENT_LEXICON_ID,
	CONTENT_LEXICON_DESCRIPTION,
	contentSchemaFields,
} from '../lib/lexicon/schema-doc';
import { parseInlineCode } from '../lib/lexicon/inline-code';

const contentFields = contentSchemaFields();
const schemaJson = JSON.stringify( CONTENT_LEXICON, null, 2 );

// Hand-authored interop tables (site.standard.* are community-owned; see Decision 0005).
const documentFields = [
	{ name: 'site', req: true, value: "your publication's at:// URI; it links the document to its publication, which Bluesky needs for the rich link card" },
	{ name: 'title', req: true, value: 'the document title' },
	{ name: 'publishedAt', req: true, value: 'when it was published (ISO datetime)' },
	{ name: 'path', req: false, value: "/<rkey>, the document's own record key; the canonical URL is the publication url plus this path" },
	{ name: 'description', req: false, value: 'a short excerpt' },
	{ name: 'textContent', req: false, value: "plain text of the article; it's what Bluesky indexes for search and reading time, so we always write it" },
	{ name: 'content', req: false, value: 'the open content union, where our blog.skypress.content.gutenberg object lives' },
	{ name: 'bskyPostRef', req: false, value: 'a reference back to the companion Bluesky post' },
	{ name: 'updatedAt', req: false, value: 'set when an article is edited' },
];

const publicationFields = [
	{ name: 'url', req: true, value: 'https://skypress.blog/@<handle>, your SkyPress home; articles hang off it' },
	{ name: 'name', req: true, value: 'the publication name (defaults from your handle)' },
	{ name: 'description', req: false, value: 'an optional description' },
	{ name: 'icon', req: false, value: 'an optional icon image' },
];
---

<Base
	title="The lexicon: how SkyPress stores your writing"
	description="The open AT Protocol records SkyPress writes to your account when you publish: a publication, a document with your block content, and a Bluesky post linking back."
>
	<header class="lex-masthead">
		<a class="lex-home" href="/" aria-label="SkyPress home"><Logo /></a>
		<a class="btn btn--ghost" href="/editor">Open the studio</a>
	</header>

	<main class="lex">
		<p class="lex-eyebrow">The open format</p>
		<h1 class="lex-title">Your words live in <em>your</em> account.</h1>
		<p class="lex-lede">
			When you publish with SkyPress, nothing gets locked inside SkyPress. Your
			writing is saved to your own AT&nbsp;Protocol account, in open formats any
			reader on the social web can understand. You can take it anywhere. Here&rsquo;s
			exactly what we write, and why.
		</p>

		<section class="lex-section">
			<h2>What gets written when you publish</h2>
			<p>Publishing creates a few records on your PDS (the data store behind your account):</p>
			<ul class="lex-records">
				<li>
					<code>site.standard.publication</code>: your SkyPress home. We create
					it once, then reuse it.
				</li>
				<li>
					<code>site.standard.document</code>: the article itself, with its
					title, a plain-text copy, and your block content.
				</li>
				<li>
					<code>app.bsky.feed.post</code>: a public Bluesky post that links back
					to the article, so people can find it.
				</li>
			</ul>
			<p class="lex-honest">
				One thing worth repeating: publishing also creates a public Bluesky post.
				We&rsquo;ll always remind you before you hit publish&nbsp;:)
			</p>
		</section>

		<section class="lex-section">
			<h2>The format we own: <code>{ CONTENT_LEXICON_ID }</code></h2>
			<p>{ parseInlineCode( CONTENT_LEXICON_DESCRIPTION ).map( ( s ) => ( s.code ? <code>{ s.text }</code> : s.text ) ) }</p>
			<table class="lex-table">
				<thead>
					<tr><th scope="col">Field</th><th scope="col">Type</th><th scope="col">Required</th><th scope="col">What it is</th></tr>
				</thead>
				<tbody>
					{ contentFields.map( ( f ) => (
						<tr>
							<td><code>{ f.name }</code></td>
							<td>{ f.type }</td>
							<td>{ f.required ? 'yes' : 'optional' }</td>
							<td>{ parseInlineCode( f.description ).map( ( s ) => ( s.code ? <code>{ s.text }</code> : s.text ) ) }</td>
						</tr>
					) ) }
				</tbody>
			</table>
			<p class="lex-note">
				This is the only lexicon SkyPress owns. If a reader doesn&rsquo;t understand the
				format, it falls back to the document&rsquo;s plain-text
				<code>textContent</code>, so your article is never unreadable. Here&rsquo;s
				the full schema:
			</p>
			<pre class="lex-code"><code>{ schemaJson }</code></pre>
		</section>

		<section class="lex-section">
			<h2>Interop: the <code>site.standard.*</code> surface</h2>
			<p>
				The publication and document metadata reuse the community
				<a href="https://tangled.org/standard.site/lexicons" target="_blank" rel="noopener noreferrer">standard.site</a>
				lexicons rather than anything SkyPress-specific. That way your articles are
				discoverable by other tools and readers that already speak them, not just by
				SkyPress.
			</p>

			<h3><code>site.standard.document</code>, the article</h3>
			<table class="lex-table">
				<thead>
					<tr><th scope="col">Field</th><th scope="col">Required</th><th scope="col">What SkyPress writes</th></tr>
				</thead>
				<tbody>
					{ documentFields.map( ( f ) => (
						<tr>
							<td><code>{ f.name }</code></td>
							<td>{ f.req ? 'yes' : 'optional' }</td>
							<td>{ f.value }</td>
						</tr>
					) ) }
				</tbody>
			</table>

			<h3><code>site.standard.publication</code>, your SkyPress home</h3>
			<table class="lex-table">
				<thead>
					<tr><th scope="col">Field</th><th scope="col">Required</th><th scope="col">What SkyPress writes</th></tr>
				</thead>
				<tbody>
					{ publicationFields.map( ( f ) => (
						<tr>
							<td><code>{ f.name }</code></td>
							<td>{ f.req ? 'yes' : 'optional' }</td>
							<td>{ f.value }</td>
						</tr>
					) ) }
				</tbody>
			</table>
		</section>

		<div class="lex-actions">
			<a class="btn btn--primary" href="/editor">Start writing</a>
		</div>
	</main>

	<Footer />
</Base>

<style>
	.lex-masthead {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.5rem clamp( 1.25rem, 5vw, 4rem );
		border-bottom: 1px solid var( --line );
	}
	.lex-home { text-decoration: none; }

	.lex {
		max-width: 48rem;
		margin: 0 auto;
		padding: clamp( 2.5rem, 7vh, 4.5rem ) clamp( 1.25rem, 5vw, 4rem ) 4rem;
	}
	.lex-eyebrow {
		font-family: var( --font-mono );
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.72rem;
		color: var( --sun );
		margin: 0;
	}
	.lex-title {
		font-size: clamp( 2.2rem, 6vw, 3.4rem );
		font-weight: 760;
		letter-spacing: -0.03em;
		line-height: 1.02;
		margin: 0.5rem 0 0;
	}
	.lex-title em { font-style: italic; color: var( --sun ); }
	.lex-lede {
		font-size: clamp( 1.1rem, 2.2vw, 1.3rem );
		line-height: 1.6;
		color: var( --ink-soft );
		margin: 1.25rem 0 0;
	}

	.lex-section {
		margin-top: 3rem;
		padding-top: 2.5rem;
		border-top: 1px solid var( --line );
	}
	.lex-section h2 {
		font-size: 1.5rem;
		letter-spacing: -0.02em;
		margin: 0 0 0.75rem;
	}
	.lex-section h3 {
		font-size: 1.1rem;
		margin: 2rem 0 0.6rem;
	}
	.lex-section p { color: var( --ink-soft ); line-height: 1.65; }
	.lex-section code {
		font-family: var( --font-mono );
		font-size: 0.86em;
		background: var( --sun-tint );
		color: var( --sun-strong );
		padding: 0.08em 0.36em;
		border-radius: 5px;
	}
	/* Long NSIDs (e.g. blog.skypress.content.gutenberg) have no spaces, so let
	   them break inside headings rather than overflow narrow viewports. */
	.lex-section h2 code,
	.lex-section h3 code {
		overflow-wrap: anywhere;
		word-break: break-word;
	}

	.lex-records { padding-left: 1.2rem; color: var( --ink-soft ); line-height: 1.7; }
	.lex-records li { margin: 0.35rem 0; }
	.lex-honest { color: var( --muted ); font-size: 0.95rem; }
	.lex-note { margin-top: 1.25rem; }

	.lex-table {
		width: 100%;
		border-collapse: collapse;
		margin: 1rem 0 0;
		font-size: 0.95rem;
	}
	.lex-table th,
	.lex-table td {
		text-align: left;
		vertical-align: top;
		padding: 0.6rem 0.75rem;
		border-bottom: 1px solid var( --line );
	}
	.lex-table th {
		font-family: var( --font-mono );
		text-transform: uppercase;
		letter-spacing: 0.04em;
		font-size: 0.7rem;
		color: var( --muted );
	}
	.lex-table td { color: var( --ink-soft ); }
	.lex-table td:first-child code { white-space: nowrap; }

	.lex-code {
		margin-top: 1.25rem;
		background: var( --paper-raised );
		border: 1px solid var( --line );
		border-radius: 10px;
		padding: 1rem 1.1rem;
		overflow: auto;
		font-size: 0.85rem;
		line-height: 1.55;
	}
	.lex-code code {
		font-family: var( --font-mono );
		background: none;
		color: var( --ink );
		padding: 0;
	}

	.lex-actions {
		display: flex;
		gap: 0.85rem;
		flex-wrap: wrap;
		margin-top: 3rem;
		padding-top: 2.5rem;
		border-top: 1px solid var( --line );
	}
</style>
