---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Footer from '../components/Footer.astro';
import AccountMenu from '../components/AccountMenu.tsx';
import HandleStart from '../components/HandleStart';
import { PHASES, DEFAULT_PHASE } from '../lib/landing/time-of-day';

const fallback = PHASES[ DEFAULT_PHASE ];
---

<Base
	title="SkyPress — a writing studio for the open social web"
	description="A standalone, long-form writing studio for the AT Protocol. Write in blocks and publish to the open social web, under your own account."
	phase={DEFAULT_PHASE}
>
	<Fragment slot="head">
		<script is:inline>
			// Set the sky phase before first paint so there is no flash.
			// Boundaries mirror src/lib/landing/time-of-day.ts (kept in sync by its test).
			( function () {
				var h = new Date().getHours();
				var p =
					h >= 21 || h < 5 ? 'night'
					: h < 7 ? 'dawn'
					: h < 10 ? 'morning'
					: h < 16 ? 'midday'
					: h < 19 ? 'golden'
					: 'dusk';
				document.documentElement.dataset.phase = p;
			} )();
		</script>
	</Fragment>

	<div class="page">
		<div class="sky" aria-hidden="true">
			<div class="stars"></div>
			<span class="shootingstar"></span>
			<div class="bloom"></div>
			<div class="halo"></div>
			<div class="horizon"></div>
		</div>

		<header class="masthead">
			<Logo />
			<div class="masthead__right">
				<a class="btn btn--ghost masthead-write" href="/editor">Write</a>
				<AccountMenu client:only="react" />
			</div>
		</header>

		<main class="hero">
			<p class="eyebrow" id="greet">{fallback.greeting}</p>
			<h1 class="hero__title" id="headline" set:html={fallback.headlineHtml} />
			<p class="hero__lede" id="lede">{fallback.lede}</p>
			<div class="hero__cta">
				<HandleStart client:only="react" />
			</div>
			<p class="hero__free">Free &amp; open-source &mdash; your words live in your account, not ours.</p>
		</main>

		<section class="showcase">
			<p class="showcase__label">See it in action</p>
			<div class="showcase__strip">
				<figure class="shot">
					<div class="shot__frame"><img src="/screenshots/editor.png" alt="The SkyPress block editor" loading="lazy" /></div>
					<figcaption>The editor</figcaption>
				</figure>
				<figure class="shot">
					<div class="shot__frame"><img src="/screenshots/published-article.png" alt="A published SkyPress article" loading="lazy" /></div>
					<figcaption>A published piece</figcaption>
				</figure>
				<figure class="shot">
					<div class="shot__frame"><img src="/screenshots/author-page.png" alt="An author's publications page" loading="lazy" /></div>
					<figcaption>All your publications</figcaption>
				</figure>
			</div>
			<p class="showcase__honest">One thing worth knowing: when you publish, SkyPress also posts to Bluesky with a link back, so people can find your piece. We&rsquo;ll always remind you before you hit publish&nbsp;:)</p>
		</section>

		<Footer />
	</div>
</Base>

<script>
	import { PHASES, phaseForHour } from '../lib/landing/time-of-day';

	const now = new Date();
	const phase = PHASES[ phaseForHour( now.getHours() ) ];
	const greet = document.getElementById( 'greet' );
	const headline = document.getElementById( 'headline' );
	const lede = document.getElementById( 'lede' );
	const hh = String( now.getHours() ).padStart( 2, '0' );
	const mm = String( now.getMinutes() ).padStart( 2, '0' );
	if ( greet ) greet.textContent = `${ phase.greeting } · ${ hh }:${ mm }`;
	if ( headline ) headline.innerHTML = phase.headlineHtml;
	if ( lede ) lede.textContent = phase.lede;
</script>

<style>
	.page {
		position: relative;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	/* ===== Atmospheric sky (hero backdrop) — varies by [data-phase] ===== */
	.sky {
		position: absolute;
		inset: 0 0 auto 0;
		height: 78vh;
		min-height: 32rem;
		z-index: 0;
		pointer-events: none;
	}
	.sky .stars,
	.sky .bloom,
	.sky .halo {
		position: absolute;
		inset: 0;
		transition: opacity 0.6s ease;
	}
	.bloom {
		background: radial-gradient(
			ellipse 46% 42% at 50% 78%,
			rgba(255, 238, 200, 0.55),
			rgba(255, 200, 120, 0.3) 40%,
			transparent 72%
		);
	}
	.halo {
		background: radial-gradient(circle at 50% 62%, transparent 0 70px, rgba(255, 236, 200, 0.85) 71px 73px, transparent 74px);
		filter: drop-shadow(0 0 26px rgba(255, 200, 120, 0.45));
	}
	.horizon {
		position: absolute;
		left: 0;
		right: 0;
		top: 70%;
		height: 1px;
		background: linear-gradient(90deg, transparent, rgba(232, 146, 12, 0.7), transparent);
	}
	.stars {
		opacity: 0;
		background-image:
			radial-gradient(1.5px 1.5px at 20% 18%, #fff, transparent),
			radial-gradient(1.5px 1.5px at 67% 12%, #fff, transparent),
			radial-gradient(1px 1px at 43% 30%, #fff, transparent),
			radial-gradient(1px 1px at 82% 24%, #fff, transparent),
			radial-gradient(1.5px 1.5px at 12% 38%, #fff, transparent),
			radial-gradient(1px 1px at 90% 40%, #fff, transparent),
			radial-gradient(1px 1px at 33% 9%, #fff, transparent);
	}

	/* Playful: a rare shooting star, dark phases only (silenced under reduced motion below). */
	.shootingstar {
		position: absolute;
		top: 12%;
		left: -8%;
		width: 90px;
		height: 2px;
		background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.9));
		border-radius: 2px;
		transform: rotate(16deg);
		opacity: 0;
	}
	:global([data-phase='night']) .shootingstar,
	:global([data-phase='dusk']) .shootingstar,
	:global([data-phase='dawn']) .shootingstar {
		animation: shoot 12s ease-in 4s infinite;
	}
	@keyframes shoot {
		0% { left: -8%; top: 12%; opacity: 0; }
		2% { opacity: 1; }
		9% { left: 78%; top: 40%; opacity: 0; }
		100% { left: 78%; top: 40%; opacity: 0; }
	}

	/* Per-phase sky gradient + star visibility + hero text colour */
	:global([data-phase='night']) .sky { background: linear-gradient(180deg, #080611, #140f28 50%, #231a38); }
	:global([data-phase='night']) .stars { opacity: 1; }
	/* Night is the bare starfield — no sun glow, halo ring, or lit horizon. */
	:global([data-phase='night']) .bloom,
	:global([data-phase='night']) .halo,
	:global([data-phase='night']) .horizon { opacity: 0; }
	:global([data-phase='dawn']) .sky { background: linear-gradient(180deg, #231533, #7a2f63 42%, #d7613a 78%, #f4a14a); }
	:global([data-phase='dawn']) .stars { opacity: 0.5; }
	:global([data-phase='morning']) .sky { background: linear-gradient(180deg, #3a2752, #c0567f 34%, #f5934a 70%, #ffd98a); }
	:global([data-phase='midday']) .sky { background: linear-gradient(180deg, #e9b977, #f7dca5 45%, #fdf0d6); }
	:global([data-phase='golden']) .sky { background: linear-gradient(180deg, #4a2150, #b5417a 30%, #ef7d3a 64%, #f9c25a 92%, #ffe6ab); }
	:global([data-phase='dusk']) .sky { background: linear-gradient(180deg, #140f2a, #4a2150 38%, #93324f 70%, #c75a3b); }
	:global([data-phase='dusk']) .stars { opacity: 0.5; }

	/* The whole sky zone (masthead + hero) is coloured by the phase, independent of the
	   OS theme: light text on dark skies, ink on the pale midday sky. */
	:global([data-phase='night']) .masthead, :global([data-phase='night']) .hero,
	:global([data-phase='dawn']) .masthead, :global([data-phase='dawn']) .hero,
	:global([data-phase='morning']) .masthead, :global([data-phase='morning']) .hero,
	:global([data-phase='golden']) .masthead, :global([data-phase='golden']) .hero,
	:global([data-phase='dusk']) .masthead, :global([data-phase='dusk']) .hero {
		--sky-ink: #fbf7ef;
		--sky-soft: rgba(251, 247, 239, 0.94);
		--sky-line: rgba(251, 247, 239, 0.55);
		--sky-chip: rgba(255, 255, 255, 0.12);
		--sky-shadow: 0 1px 14px rgba(20, 10, 4, 0.4);
	}
	:global([data-phase='midday']) .masthead, :global([data-phase='midday']) .hero {
		--sky-ink: #241a10;
		--sky-soft: rgba(36, 26, 16, 0.9);
		--sky-line: rgba(36, 26, 16, 0.42);
		--sky-chip: rgba(0, 0, 0, 0.05);
		--sky-shadow: 0 1px 12px rgba(255, 248, 234, 0.6);
	}

	/* Logo wordmark (in the Logo component) follows the sky, not the OS theme. */
	.masthead :global(.logo),
	.masthead :global(.logo__word) {
		color: var(--sky-ink);
	}

	/* Playful: the wordmark's sun becomes a crescent moon at night/dusk (landing only —
	   data-phase is set on <html> only here, so other pages keep the sun). */
	:global([data-phase='night']) .masthead :global(.logo__sun),
	:global([data-phase='dusk']) .masthead :global(.logo__sun) { display: none; }
	:global([data-phase='night']) .masthead :global(.logo__moon),
	:global([data-phase='dusk']) .masthead :global(.logo__moon) { display: block; }

	/* Ghost buttons sitting on the sky get a frosted chip so they read at every phase. */
	.masthead .btn--ghost,
	.hero .btn--ghost {
		background: var(--sky-chip);
		color: var(--sky-ink);
		border-color: var(--sky-line);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
	}
	.masthead .btn--ghost:hover,
	.hero .btn--ghost:hover {
		color: var(--sky-ink);
		border-color: var(--sky-ink);
	}

	/* Signed-in account menu — frosted sky-chip trigger + dropdown. AccountMenu is
	   a `client:only` React island, so Astro's scoped styles never reach its DOM;
	   target it with `:global()`. The `.masthead` prefix stays scoped so it still
	   inherits the per-phase `--sky-*` custom properties. */
	.masthead :global(.account-menu) {
		position: relative;
	}
	.masthead :global(.account-menu__trigger) {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.32rem 0.7rem 0.32rem 0.4rem;
		border-radius: var(--radius-sm);
		background: var(--sky-chip);
		border: 1px solid var(--sky-line);
		color: var(--sky-ink);
		font: inherit;
		cursor: pointer;
		text-shadow: var(--sky-shadow);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
	}
	.masthead :global(.account-menu__trigger:hover) {
		border-color: var(--sky-ink);
	}
	.masthead :global(.account-menu__avatar) {
		width: 30px;
		height: 30px;
		border-radius: 50%;
		object-fit: cover;
		flex: none;
	}
	.masthead :global(.account-menu__avatar--fallback) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: var(--sun-tint);
		color: var(--sun);
		font-weight: 700;
		font-size: 0.85rem;
	}
	.masthead :global(.account-menu__who) {
		display: flex;
		flex-direction: column;
		line-height: 1.1;
		text-align: left;
	}
	.masthead :global(.account-menu__name) {
		font-weight: 680;
		font-size: 0.86rem;
	}
	.masthead :global(.account-menu__handle) {
		font-size: 0.72rem;
		opacity: 0.8;
	}
	.masthead :global(.account-menu__dropdown) {
		position: absolute;
		top: calc(100% + 0.4rem);
		right: 0;
		min-width: 11rem;
		display: flex;
		flex-direction: column;
		padding: 0.3rem;
		border-radius: var(--radius-sm);
		background: var(--paper-raised);
		border: 1px solid var(--line-strong);
		box-shadow: var(--shadow);
		z-index: 5;
		animation: account-menu-in 0.14s ease;
	}
	/* Transparent bridge across the visual gap below the trigger, so moving the
	   cursor from the trigger into the dropdown never leaves `.account-menu` (which
	   would fire mouseleave and close the menu before the pointer arrives). */
	.masthead :global(.account-menu__dropdown)::before {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		top: -0.4rem;
		height: 0.4rem;
	}
	.masthead :global(.account-menu__item) {
		padding: 0.5rem 0.7rem;
		border-radius: calc(var(--radius-sm) - 2px);
		color: var(--ink);
		font-size: 0.88rem;
		text-decoration: none;
	}
	.masthead :global(.account-menu__item:hover) {
		background: var(--line);
		color: var(--ink);
	}
	@keyframes account-menu-in {
		from {
			opacity: 0;
			transform: translateY(-4px);
		}
	}

	.masthead {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.5rem clamp(1.25rem, 5vw, 4rem);
	}
	.masthead__right {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	/* AccountMenu sets data-signed-in once a session restores; hide the static link then. */
	.masthead__right[data-signed-in] .masthead-write {
		display: none;
	}
	.hero {
		position: relative;
		z-index: 2;
		flex: 1;
		width: 100%;
		max-width: 46rem;
		margin: 0 auto;
		padding: clamp(2rem, 9vh, 5rem) clamp(1.25rem, 5vw, 4rem) clamp(3rem, 8vh, 5rem);
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}
	.hero .eyebrow { color: var(--sun); }
	.hero__title {
		font-size: clamp(2.7rem, 8vw, 5rem);
		font-weight: 760;
		letter-spacing: -0.035em;
		line-height: 0.98;
		margin: 0.75rem 0 0;
		max-width: 14ch;
		color: var(--sky-ink);
		text-shadow: var(--sky-shadow);
	}
	.hero__title :global(em) {
		font-style: italic;
		color: var(--sun);
	}
	.hero__lede {
		font-size: clamp(1.1rem, 2.2vw, 1.35rem);
		line-height: 1.5;
		color: var(--sky-soft);
		max-width: 36ch;
		margin: 1.25rem 0 0;
		text-shadow: var(--sky-shadow);
	}
	/* ===== See it in action (themed surface below the sky) ===== */
	.showcase {
		position: relative;
		z-index: 2;
		background: var(--paper);
		border-top: 1px solid var(--line);
		padding: clamp(2.5rem, 6vw, 4rem) clamp(1.25rem, 5vw, 4rem);
	}
	.showcase__label {
		max-width: 64rem;
		margin: 0 auto 1.25rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--sun);
	}
	.showcase__strip {
		max-width: 64rem;
		margin: 0 auto;
		display: grid;
		gap: 1.25rem;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
	}
	.shot { margin: 0; }
	.shot__frame {
		border: 1px solid var(--line-strong);
		border-radius: var(--radius);
		overflow: hidden;
		background: var(--paper-raised);
		box-shadow: var(--shadow);
		aspect-ratio: 16 / 10;
	}
	.shot__frame img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
	.shot figcaption {
		margin-top: 0.6rem;
		font-size: 0.9rem;
		color: var(--ink-soft);
	}
	.showcase__honest {
		max-width: 64rem;
		margin: 2.5rem auto 0;
		color: var(--muted);
		font-size: 0.95rem;
	}

	/* ===== Handle input island (lives on the sky) ===== */
	.hero__cta { width: 100%; max-width: 26rem; margin: 2rem auto 0; }
	.hero__free {
		color: var(--sky-soft);
		font-size: 0.9rem;
		margin-top: 1rem;
		text-shadow: var(--sky-shadow);
	}
	.hero :global(.handlestart__row) { display: flex; gap: 0.5rem; }
	.hero :global(.handlestart__field) {
		flex: 1;
		display: flex;
		align-items: center;
		gap: 0.15rem;
		background: var(--sky-chip);
		border: 1px solid var(--sky-line);
		border-radius: var(--radius-sm);
		padding: 0.6rem 0.75rem;
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
	}
	.hero :global(.handlestart__at) { color: var(--sky-soft); }
	.hero :global(.handlestart__input) {
		flex: 1;
		border: none;
		background: transparent;
		color: var(--sky-ink);
		font: inherit;
		outline: none;
	}
	.hero :global(.handlestart__input::placeholder) { color: var(--sky-soft); opacity: 0.7; }
	.hero :global(.handlestart__spinner) {
		width: 14px; height: 14px; flex: none;
		border: 2px solid var(--sky-line);
		border-top-color: var(--sky-ink);
		border-radius: 50%;
		animation: handlestart-spin 0.7s linear infinite;
	}
	.hero :global(.handlestart__go) {
		border: none;
		border-radius: var(--radius-sm);
		padding: 0.6rem 1rem;
		font: inherit;
		font-weight: 650;
		white-space: nowrap;
		color: #fff;
		background: var(--btn-primary);
		cursor: pointer;
		transition: background 0.12s ease, box-shadow 0.12s ease;
	}
	.hero :global(.handlestart__go:hover) { background: var(--btn-primary-hover); }
	.hero :global(.handlestart__card) {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		margin-top: 0.6rem;
		padding: 0.45rem 0.6rem;
		background: var(--sky-chip);
		border: 1px solid var(--sky-line);
		border-radius: var(--radius-sm);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		text-align: left;
	}
	.hero :global(.handlestart__avatar) {
		width: 36px; height: 36px; border-radius: 50%; object-fit: cover; flex: none;
	}
	.hero :global(.handlestart__avatar--fallback) {
		display: inline-flex; align-items: center; justify-content: center;
		background: var(--sun-tint); color: var(--sun); font-weight: 700;
	}
	.hero :global(.handlestart__who) { display: flex; flex-direction: column; line-height: 1.15; }
	.hero :global(.handlestart__name) { font-weight: 680; font-size: 0.9rem; color: var(--sky-ink); }
	.hero :global(.handlestart__handle) { font-size: 0.74rem; color: var(--sky-soft); }
	.hero :global(.handlestart__check) { margin-left: auto; color: #6fce92; font-weight: 800; }
	.hero :global(.handlestart__hint) {
		color: var(--sky-soft);
		font-size: 0.82rem;
		margin: 0.6rem 0 0;
		text-shadow: var(--sky-shadow);
	}
	.hero :global(.handlestart__hint--error) { color: #ffd0c4; }
	@keyframes handlestart-spin { to { transform: rotate(360deg); } }

	@media (prefers-reduced-motion: reduce) {
		.shootingstar { animation: none; opacity: 0; }
		.sky .stars, .sky .bloom, .sky .halo { transition: none; }
		.hero :global(.handlestart__spinner) { animation: none; }
		.masthead :global(.account-menu__dropdown) {
			animation: none;
		}
	}
</style>
