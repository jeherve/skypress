---
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
import { resolveAuthor } from '../../lib/reader/identity';
import { listReaderPublications } from '../../lib/reader/publications';
import { fetchActorProfile } from '../../lib/reader/profile';
import { buildGetBlobUrl } from '../../lib/media/blob';
import CreatePublicationCta from '../../components/CreatePublicationCta.tsx';

export const prerender = false;

const { author } = Astro.params;
if ( ! author || ! author.startsWith( '@' ) ) {
	return new Response( 'Not found', { status: 404 } );
}
const handle = author.slice( 1 );

const resolved = await resolveAuthor( handle );
if ( ! resolved ) {
	return new Response( `Could not resolve @${ handle }`, { status: 404 } );
}
const { did, pdsUrl } = resolved;

const [ profile, publications ] = await Promise.all( [
	fetchActorProfile( pdsUrl, did ),
	listReaderPublications( pdsUrl, did ),
] );

const authorName = profile.displayName ?? `@${ handle }`;
const initial = authorName.replace( /^@/, '' ).charAt( 0 ).toUpperCase();
---

<Base title={`${ authorName } — SkyPress`} description={profile.description ?? undefined}>
	<header class="masthead">
		<a href="/"><Logo /></a>
	</header>

	<main class="author">
		<div class="author__hero">
			{profile.banner && (
				<div class="author__cover" style={`background-image:url("${ profile.banner }")`} aria-hidden="true"></div>
			)}
			<div class={`author__identity${ profile.banner ? ' author__identity--overlap' : '' }`}>
				{profile.avatar ? (
					<img class="author__avatar" src={profile.avatar} alt="" width="96" height="96" />
				) : (
					<span class="author__avatar author__avatar--fallback" aria-hidden="true">{initial}</span>
				)}
				<h1 class="author__name">{authorName}</h1>
				<p class="author__handle">
					<a
						class="author__handle-link"
						href={`https://bsky.app/profile/${ handle }`}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={`View @${ handle } on Bluesky`}
					>
						@{handle}
						<svg
							class="author__handle-arrow"
							width="11"
							height="11"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M7 17 17 7" />
							<path d="M8 7h9v9" />
						</svg>
					</a>
				</p>
				{profile.description && <p class="author__bio">{profile.description}</p>}
			</div>
		</div>

		<h2 class="author__heading">Publications</h2>
		{publications.length === 0 ? (
			<div class="author__emptyblock">
				<p class="author__empty">No SkyPress publications yet.</p>
				<CreatePublicationCta client:only="react" profileDid={did} />
			</div>
		) : (
			<ul class="author__list">
				{publications.map( ( pub ) => {
					const logoUrl = pub.icon
						? buildGetBlobUrl( pdsUrl, did, pub.icon.ref.$link )
						: null;
					return (
						<li class="author__item">
							<a class="author__pub" href={`/@${ handle }/${ pub.slug }`}>
								{logoUrl ? (
									<img class="author__publogo" src={logoUrl} alt="" width="52" height="52" />
								) : (
									<span class="author__publogo author__publogo--fallback" aria-hidden="true">
										{pub.name.charAt( 0 ).toUpperCase()}
									</span>
								)}
								<span class="author__pubtext">
									<span class="author__pubname">{pub.name}</span>
									{pub.description && <span class="author__pubdesc">{pub.description}</span>}
								</span>
							</a>
						</li>
					);
				} )}
			</ul>
		)}
	</main>
</Base>

<style>
	.masthead {
		padding: 1.5rem clamp(1.25rem, 5vw, 4rem);
		border-bottom: 1px solid var(--line);
	}
	.masthead a {
		text-decoration: none;
	}
	.author {
		max-width: 44rem;
		margin: 0 auto;
		padding: 0 1.5rem 6rem;
	}
	.author__hero {
		margin: 0 0 2rem;
	}
	.author__cover {
		height: clamp(8rem, 26vw, 14rem);
		margin: 0 calc(-1 * clamp(1.5rem, 5vw, 4rem));
		background-size: cover;
		background-position: center;
		border-bottom: 1px solid var(--line);
	}
	.author__identity {
		text-align: center;
		padding-top: 2.5rem;
	}
	.author__identity--overlap {
		margin-top: -3.5rem;
	}
	.author__avatar {
		width: 96px;
		height: 96px;
		border-radius: 50%;
		object-fit: cover;
		border: 3px solid var(--paper);
		box-shadow: var(--shadow);
		background: var(--paper-raised);
	}
	.author__avatar--fallback {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-display);
		font-size: 2.6rem;
		font-weight: 700;
		color: var(--sun);
		background: var(--sun-tint);
	}
	.author__name {
		font-size: clamp(2rem, 5.5vw, 3rem);
		margin: 0.75rem 0 0.1rem;
	}
	.author__handle {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.85rem;
		margin: 0;
	}
	.author__handle-link {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		color: inherit;
		text-decoration: none;
		transition: color 0.15s ease;
	}
	.author__handle-link:hover,
	.author__handle-link:focus-visible {
		color: var(--sun);
	}
	.author__handle-arrow {
		opacity: 0;
		transform: translate(-2px, 2px);
		transition:
			opacity 0.15s ease,
			transform 0.15s ease;
	}
	.author__handle-link:hover .author__handle-arrow,
	.author__handle-link:focus-visible .author__handle-arrow {
		opacity: 1;
		transform: translate(0, 0);
	}
	.author__bio {
		color: var(--ink-soft);
		max-width: 46ch;
		margin: 1rem auto 0;
	}
	.author__heading {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--muted);
		margin: 0 0 0.75rem;
	}
	.author__empty {
		color: var(--muted);
	}
	.author__emptyblock {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
	}
	.author__list {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.author__item {
		border-top: 1px solid var(--line);
	}
	.author__pub {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1.1rem 0;
		text-decoration: none;
		color: var(--ink);
	}
	.author__publogo {
		width: 52px;
		height: 52px;
		border-radius: 12px;
		object-fit: cover;
		flex: none;
		background: var(--paper-raised);
	}
	.author__publogo--fallback {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.4rem;
		color: var(--sun);
		background: var(--sun-tint);
	}
	.author__pubtext {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.author__pubname {
		font-family: var(--font-display);
		font-size: 1.3rem;
		font-weight: 560;
	}
	.author__pub:hover .author__pubname {
		color: var(--sun);
	}
	.author__pubdesc {
		color: var(--ink-soft);
		font-size: 0.95rem;
	}
</style>
