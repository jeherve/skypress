---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	/**
	 * Optional landing-page sky phase. Rendered as `data-phase` on `<html>` so the
	 * no-JS / pre-paint default has a sky; the inline head script then overwrites it
	 * from the visitor's clock. `<html>` is the single phase carrier — see index.astro.
	 */
	phase?: string;
}
const { title, description, phase } = Astro.props;
---

<!doctype html>
<html lang="en" data-phase={phase}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		{description && <meta name="description" content={description} />}
		<title>{title}</title>
		<slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>
