---
import Base from '../../../layouts/Base.astro';
import Logo from '../../../components/Logo.astro';
import { resolveAuthor } from '../../../lib/reader/identity';
import { getRecord } from '../../../lib/reader/records';
import { resolveReaderPublication } from '../../../lib/reader/publications';
import { resolveBlobImageUrls } from '../../../lib/media/blob';
import { renderBlocks, blocksToText, type BlockNode } from '../../../lib/blocks/render';
import { sanitizeArticleHtml } from '../../../lib/reader/sanitize';
import { canonicalArticleUrl } from '../../../lib/publish/records';

// Frontend block styles only — no editor chrome, no JS.
import '@wordpress/block-library/build-style/common.css';
import '@wordpress/block-library/build-style/style.css';
import '@wordpress/block-library/build-style/theme.css';

// Read-through renderer: resolve + fetch at request time (Decision 0007).
export const prerender = false;

interface SkyDocument {
	title?: string;
	description?: string;
	textContent?: string;
	publishedAt?: string;
	updatedAt?: string;
	site?: string;
	content?: { blocks?: BlockNode[] };
}

const { author, slug, rkey } = Astro.params;

if ( ! author || ! author.startsWith( '@' ) || ! slug || ! rkey ) {
	return new Response( 'Not found', { status: 404 } );
}
const handle = author.slice( 1 );

const resolved = await resolveAuthor( handle );
if ( ! resolved ) {
	return new Response( `Could not resolve @${ handle }`, { status: 404 } );
}
const { did, pdsUrl } = resolved;

// Resolve the publication by slug (Decision 0010), then the document by rkey.
const publication = await resolveReaderPublication( pdsUrl, did, slug );
if ( ! publication ) {
	return new Response( 'Publication not found', { status: 404 } );
}

const record = await getRecord< SkyDocument >( pdsUrl, did, 'site.standard.document', rkey );
if ( ! record?.value ) {
	return new Response( 'Article not found', { status: 404 } );
}

// A document only renders under the publication it belongs to (Decision 0010, §3 step 3).
if ( record.value.site !== publication.uri ) {
	return new Response( 'Article not found in this publication', { status: 404 } );
}

const doc = record.value;
const blocks = resolveBlobImageUrls( doc.content?.blocks ?? [], { pdsUrl, did } );
const html = sanitizeArticleHtml( renderBlocks( blocks ) );
const textContent = doc.textContent || blocksToText( blocks );

const title = doc.title ?? 'Untitled';
const description = doc.description || textContent.slice( 0, 200 );
const canonical = canonicalArticleUrl( handle, slug, rkey );
const docUri = `at://${ did }/site.standard.document/${ rkey }`;
const pubUrl = `/${ author }/${ slug }`;
const feedHref = `${ pubUrl }/rss.xml`;

const words = textContent.split( /\s+/ ).filter( Boolean ).length;
const readingMinutes = Math.max( 1, Math.round( words / 200 ) );
const publishedLabel = doc.publishedAt ? doc.publishedAt.slice( 0, 10 ) : null;
const updatedLabel = doc.updatedAt ? doc.updatedAt.slice( 0, 10 ) : null;
---

<Base title={`${ title } — ${ publication.name }`} description={description}>
	<Fragment slot="head">
		{/* standard.site indexing tags (brief §3) — Bluesky cards + AppView pickup */}
		<link rel="site.standard.document" href={docUri} />
		<link rel="site.standard.publication" href={publication.uri} />
		<link rel="alternate" type="application/rss+xml" title={`${ publication.name } — RSS`} href={feedHref} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="article" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
	</Fragment>

	<header class="masthead">
		<a href="/"><Logo /></a>
	</header>
	<main class="reader">
		<p class="reader__meta eyebrow">
			<a class="reader__author" href={pubUrl}>{publication.name}</a>
			{publishedLabel && <> · {publishedLabel}</>}
			{updatedLabel && <> · updated {updatedLabel}</>}
			· {readingMinutes} min read
		</p>
		<h1 class="reader__title">{title}</h1>
		<article class="reader__article" set:html={html} />
		<footer class="reader__foot">
			<a class="reader__author" href={pubUrl}>More from {publication.name}</a>
		</footer>
	</main>
</Base>

<style>
	.masthead {
		padding: 1.5rem clamp(1.25rem, 5vw, 4rem);
		border-bottom: 1px solid var(--line);
	}
	.masthead a {
		text-decoration: none;
	}
	.reader {
		max-width: 40rem;
		margin: 0 auto;
		padding: clamp(2.5rem, 6vw, 4.5rem) 1.5rem 6rem;
	}
	.reader__meta {
		margin-bottom: 1.25rem;
	}
	.reader__author {
		color: var(--sun);
		text-decoration: none;
	}
	.reader__title {
		font-size: clamp(2.2rem, 5.5vw, 3.4rem);
		line-height: 1.04;
		margin: 0 0 2.25rem;
	}
	.reader__article {
		font-family: var(--font-body);
		font-size: 1.22rem;
		line-height: 1.72;
		color: var(--ink);
	}
	.reader__article :global(h2),
	.reader__article :global(h3) {
		margin: 2.4rem 0 0.8rem;
	}
	.reader__article :global(h2) {
		font-size: 1.7rem;
	}
	.reader__article :global(p) {
		margin: 1.2rem 0;
	}
	.reader__article :global(a) {
		color: var(--sun);
	}
	/* First paragraph: a quiet editorial lead-in */
	.reader__article :global(p:first-of-type) {
		font-size: 1.32rem;
		color: var(--ink-soft);
	}
	.reader__article :global(blockquote) {
		margin: 1.8rem 0;
		padding-left: 1.25rem;
		border-left: 3px solid var(--sun);
		font-style: italic;
		color: var(--ink-soft);
	}
	.reader__article :global(img) {
		max-width: 100%;
		height: auto;
		border-radius: var(--radius);
		box-shadow: var(--shadow);
	}
	.reader__article :global(pre) {
		background: var(--ink);
		color: var(--paper);
		font-family: var(--font-mono);
		padding: 1.1rem 1.25rem;
		border-radius: var(--radius);
		overflow: auto;
		font-size: 0.92rem;
		line-height: 1.5;
	}
	.reader__article :global(code) {
		font-family: var(--font-mono);
	}
	.reader__foot {
		margin-top: 3.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--line);
	}
</style>
