---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Studio from '../components/Studio.tsx';
---

<Base title="Write — SkyPress">
	<main class="editor-shell">
		<header class="editor-shell__bar">
			<a class="editor-shell__home" href="/"><Logo size={24} /></a>
			<span class="editor-shell__hint eyebrow">The studio</span>
		</header>
		<!-- client:only — auth + editor run only in the browser; their bundle never
		     reaches reading pages (Decisions 0001 & 0004). -->
		<Studio client:only="react">
			<p slot="fallback" class="editor-shell__loading">Loading…</p>
		</Studio>
	</main>
</Base>

<style>
	.editor-shell__bar {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.75rem 1.25rem;
		border-bottom: 1px solid var(--line);
		flex-wrap: wrap;
	}
	.editor-shell__home {
		display: inline-flex;
		font-weight: 700;
		color: var(--ink);
		text-decoration: none;
	}
	.editor-shell__hint {
		font-size: 0.85rem;
		line-height: 1;
	}
	.editor-shell__loading {
		padding: 2rem 1.25rem;
		color: var(--muted);
	}
</style>

<!-- The Studio is a `client:only` React island, so Astro's scoped styles never
     reach its DOM. The editor-surface rules below must therefore be global. -->
<style is:global>
	.studio__loading {
		padding: 2rem 1.25rem;
		color: var(--muted);
	}

	/* Account bar (signed in) */
	.studio__account {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.5rem 1.25rem;
		background: var(--panel);
		border-bottom: 1px solid var(--line);
		font-size: 0.9rem;
		flex-wrap: wrap;
	}
	.studio__identity {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		min-width: 0;
	}
	.studio__avatar {
		width: 38px;
		height: 38px;
		border-radius: 50%;
		object-fit: cover;
		flex: none;
	}
	.studio__avatar--fallback {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: var(--sun-tint);
		color: var(--sun);
		font-weight: 700;
	}
	.studio__who {
		display: flex;
		flex-direction: column;
		line-height: 1.15;
		min-width: 0;
	}
	.studio__name {
		font-weight: 680;
	}
	.studio__handle {
		color: var(--muted);
		font-size: 0.8rem;
	}
	.studio__account-actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}
	.studio__viewpage {
		color: var(--sun);
		text-decoration: none;
		font-size: 0.85rem;
		padding: 0.3rem 0.5rem;
		border-radius: var(--radius-sm);
	}
	.studio__viewpage:hover {
		text-decoration: underline;
	}
	.studio__signout {
		border: 1px solid var(--line-strong);
		background: var(--paper-raised);
		border-radius: var(--radius-sm);
		padding: 0.3rem 0.7rem;
		cursor: pointer;
		font: inherit;
	}

	/* Login (signed out) */
	.studio__login {
		max-width: 30rem;
		margin: 0 auto;
		padding: 4rem 1.5rem;
	}
	.studio__error,
	.login__error {
		color: var(--ember);
		font-size: 0.9rem;
	}
	.login__title {
		font-size: 1.6rem;
		margin: 0 0 0.5rem;
	}
	.login__lede {
		color: var(--muted);
		margin: 0 0 1.5rem;
	}
	.login__label {
		display: block;
		font-size: 0.85rem;
		font-weight: 600;
		margin-bottom: 0.35rem;
	}
	.login__input {
		width: 100%;
		box-sizing: border-box;
		padding: 0.6rem 0.7rem;
		border: 1px solid var(--line-strong);
		border-radius: 8px;
		font: inherit;
		margin-bottom: 0.85rem;
	}
	.login__submit {
		width: 100%;
		padding: 0.65rem 1rem;
		border: 0;
		border-radius: 8px;
		background: var(--sun);
		color: #fff;
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	.login__note {
		color: var(--muted);
		font-size: 0.8rem;
		margin-top: 1rem;
	}

	/* Publish panel */
	.publish {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		padding: 0.75rem 1.25rem;
		border-bottom: 1px solid var(--line);
	}
	.publish__title {
		flex: 1 1 18rem;
		padding: 0.5rem 0.7rem;
		border: 1px solid var(--line-strong);
		border-radius: 8px;
		font: inherit;
		font-size: 1.05rem;
	}
	.publish__target {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.85rem;
		color: var(--muted);
	}
	.publish__target--fixed strong {
		color: var(--ink);
	}
	.publish__select {
		padding: 0.45rem 0.6rem;
		border: 1px solid var(--line-strong);
		border-radius: 8px;
		background: var(--paper-raised);
		font: inherit;
		font-size: 0.9rem;
	}
	.publish__button {
		padding: 0.5rem 1rem;
		border: 0;
		border-radius: 8px;
		background: var(--sun);
		color: #fff;
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	.publish__button:disabled {
		opacity: 0.5;
		cursor: not-allowed;
	}
	.publish__cancel {
		padding: 0.5rem 0.9rem;
		border: 1px solid var(--line-strong);
		background: var(--paper-raised);
		border-radius: 8px;
		font: inherit;
		cursor: pointer;
	}
	.publish__confirm {
		flex: 1 1 100%;
		background: var(--sun-tint);
		border: 1px solid var(--line-strong);
		border-radius: 10px;
		padding: 0.85rem 1rem;
	}
	.publish__warning {
		margin: 0 0 0.75rem;
	}
	.publish__actions {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}
	.publish__result,
	.publish__status,
	.publish__error {
		flex: 1 1 100%;
		font-size: 0.9rem;
	}
	.publish__result code {
		word-break: break-all;
		background: var(--panel);
		padding: 0.1rem 0.3rem;
		border-radius: 4px;
	}
	.publish__error {
		color: var(--ember);
	}

	/* Your articles + mode bar */
	.myarticles {
		padding: 1rem 1.25rem;
		border-bottom: 1px solid var(--line);
	}
	.myarticles__heading {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--muted);
		margin: 0 0 0.5rem;
	}
	.myarticles__loading {
		padding: 1rem 1.25rem;
		color: var(--muted);
		font-size: 0.9rem;
	}
	.myarticles__list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.myarticles__item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.4rem 0;
	}
	.myarticles__edited,
	.myarticles__pub {
		color: var(--muted);
		font-style: normal;
		font-size: 0.85rem;
	}
	.myarticles__pub {
		font-family: var(--font-mono);
		font-size: 0.78rem;
	}
	.myarticles__actions {
		display: flex;
		gap: 0.5rem;
	}
	.myarticles__actions button {
		border: 1px solid var(--line-strong);
		background: var(--paper-raised);
		border-radius: 6px;
		padding: 0.25rem 0.6rem;
		font: inherit;
		font-size: 0.85rem;
		cursor: pointer;
	}
	.studio__mode {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.5rem 1.25rem;
		font-size: 0.85rem;
		color: var(--muted);
	}
	.studio__mode button {
		border: 1px solid var(--line-strong);
		background: var(--paper-raised);
		border-radius: 6px;
		padding: 0.25rem 0.7rem;
		font: inherit;
		cursor: pointer;
	}

	/* Editor surface. The bundled isolated-block-editor CSS hard-codes a
	   full-width white surface that ignores `prefers-color-scheme`. Constrain
	   and frame it as a contained writing panel, and drive its colours from the
	   design tokens so it follows light/dark like the rest of the app. */
	.skypress-editor {
		max-width: 60rem;
		margin: 1.5rem auto 3rem;
		padding: 0 1.25rem;
	}
	.skypress-editor .iso-editor {
		background-color: var(--paper-raised);
		border: 1px solid var(--line-strong);
		border-radius: var(--radius);
		color: var(--ink);
		box-shadow: var(--shadow);
	}
	.skypress-editor .iso-editor .edit-post-visual-editor {
		background-color: transparent;
	}
	/* Gutenberg sets `background: white` inline on the device-preview wrapper;
	   only !important lets the paper surface show through (esp. in dark mode). */
	.skypress-editor .iso-editor .edit-post-visual-editor .is-desktop-preview {
		background: transparent !important;
	}
	.skypress-editor__status {
		margin: 0.75rem 0 0;
		color: var(--muted);
		font-size: 0.85rem;
	}
</style>
