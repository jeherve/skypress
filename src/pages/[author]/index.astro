---
import Base from '../../layouts/Base.astro';
import { resolveAuthor } from '../../lib/reader/identity';
import { listRecords } from '../../lib/reader/records';
import { publicationHomeUrl } from '../../lib/publish/records';

export const prerender = false;

interface PublicationValue {
	url?: string;
	name?: string;
	description?: string;
}
interface DocumentValue {
	title?: string;
	description?: string;
	site?: string;
	publishedAt?: string;
}

const { author } = Astro.params;
if ( ! author || ! author.startsWith( '@' ) ) {
	return new Response( 'Not found', { status: 404 } );
}
const handle = author.slice( 1 );

const resolved = await resolveAuthor( handle );
if ( ! resolved ) {
	return new Response( `Could not resolve @${ handle }`, { status: 404 } );
}
const { did, pdsUrl } = resolved;

const wantUrl = publicationHomeUrl( handle );
const publications = await listRecords< PublicationValue >(
	pdsUrl,
	did,
	'site.standard.publication'
);
const publication = publications.find( ( record ) => record.value.url === wantUrl );

const allDocs = await listRecords< DocumentValue >(
	pdsUrl,
	did,
	'site.standard.document',
	100
);
const docs = publication
	? allDocs.filter( ( record ) => record.value.site === publication.uri )
	: [];

const pubName = publication?.value.name ?? `@${ handle }`;
const pubUri = publication?.uri;

const articles = docs.map( ( record ) => ( {
	rkey: record.uri.split( '/' ).pop() as string,
	title: record.value.title ?? 'Untitled',
	description: record.value.description,
	publishedLabel: record.value.publishedAt?.slice( 0, 10 ) ?? null,
} ) );
---

<Base title={`${ pubName } — SkyPress`} description={publication?.value.description}>
	<Fragment slot="head">
		{pubUri && <link rel="site.standard.publication" href={pubUri} />}
	</Fragment>

	<main class="home">
		<p class="home__handle">@{handle}</p>
		<h1 class="home__title">{pubName}</h1>
		{publication?.value.description && (
			<p class="home__lede">{publication.value.description}</p>
		)}

		{articles.length === 0 ? (
			<p class="home__empty">No SkyPress articles published yet.</p>
		) : (
			<ul class="home__list">
				{articles.map( ( article ) => (
					<li class="home__item">
						<a href={`/@${ handle }/${ article.rkey }`}>{article.title}</a>
						{article.publishedLabel && (
							<span class="home__date">{article.publishedLabel}</span>
						)}
						{article.description && <p class="home__desc">{article.description}</p>}
					</li>
				) )}
			</ul>
		)}
	</main>
</Base>

<style>
	.home {
		max-width: 42rem;
		margin: 0 auto;
		padding: 4rem 1.5rem 6rem;
	}
	.home__handle {
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-size: 0.75rem;
		color: var(--muted);
	}
	.home__title {
		font-size: clamp( 2rem, 5vw, 3rem );
		margin: 0.25rem 0 1rem;
	}
	.home__lede {
		color: var(--muted);
		font-size: 1.15rem;
	}
	.home__list {
		list-style: none;
		padding: 0;
		margin: 2.5rem 0 0;
	}
	.home__item {
		padding: 1.25rem 0;
		border-top: 1px solid #e7e3da;
	}
	.home__item a {
		font-size: 1.3rem;
		font-weight: 600;
		color: var(--ink);
		text-decoration: none;
	}
	.home__date {
		color: var(--muted);
		font-size: 0.8rem;
		margin-left: 0.75rem;
	}
	.home__desc {
		color: var(--muted);
		margin: 0.4rem 0 0;
	}
</style>
