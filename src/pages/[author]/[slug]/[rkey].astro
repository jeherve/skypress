---
import Base from '../../../layouts/Base.astro';
import Logo from '../../../components/Logo.astro';
import { resolveAuthor } from '../../../lib/reader/identity';
import { getRecord } from '../../../lib/reader/records';
import { resolveReaderPublication } from '../../../lib/reader/publications';
import { resolveBlobImageUrls, buildGetBlobUrl } from '../../../lib/media/blob';
import { renderBlocks, blocksToText, type BlockNode } from '../../../lib/blocks/render';
import { sanitizeArticleHtml } from '../../../lib/reader/sanitize';
import { canonicalArticleUrl } from '../../../lib/publish/records';
import { themeStyleBlock } from '../../../lib/publish/themes';
import { buildMetaTags } from '../../../lib/seo/meta';
import ErrorScene from '../../../components/ErrorScene.astro';
import { errorScene } from '../../../lib/reader/errors';
import type { ErrorSceneCopy } from '../../../lib/reader/errors';

// Frontend block styles only — no editor chrome, no JS.
import '@wordpress/block-library/build-style/common.css';
import '@wordpress/block-library/build-style/style.css';
import '@wordpress/block-library/build-style/theme.css';

// Read-through renderer: resolve + fetch at request time (Decision 0007).
export const prerender = false;

interface SkyDocument {
	title?: string;
	description?: string;
	textContent?: string;
	publishedAt?: string;
	updatedAt?: string;
	site?: string;
	content?: { blocks?: BlockNode[] };
}

const { author, slug, rkey } = Astro.params;

let error: ErrorSceneCopy | null = null;
const handle = author?.startsWith( '@' ) ? author.slice( 1 ) : '';

// Everything the happy-path template needs; populated only when there's no error.
let publication: Awaited< ReturnType< typeof resolveReaderPublication > > = null;
let metaTags: ReturnType< typeof buildMetaTags > = [];
let title = '';
let description = '';
let canonical = '';
let docUri = '';
let pubUrl = '';
let feedHref = '';
let html = '';
let readingMinutes = 1;
let publishedLabel: string | null = null;
let updatedLabel: string | null = null;
let themeStyle = '';
let ogImage = '';

if ( ! author || ! author.startsWith( '@' ) || ! slug || ! rkey ) {
	error = errorScene( 'not-found' );
}

const resolved = error ? null : await resolveAuthor( handle );
if ( ! error && ! resolved ) {
	error = errorScene( 'writer-not-found', { handle } );
}

if ( ! error && resolved ) {
	const { did, pdsUrl } = resolved;

	publication = await resolveReaderPublication( pdsUrl, did, slug! );
	if ( ! publication ) {
		error = errorScene( 'publication-not-found', { handle, slug } );
	} else {
		const record = await getRecord< SkyDocument >(
			pdsUrl,
			did,
			'site.standard.document',
			rkey!
		);
		if ( ! record?.value || record.value.site !== publication.uri ) {
			error = errorScene( 'article-not-found', {
				publicationName: publication.name,
			} );
		} else {
			const doc = record.value;
			const blocks = resolveBlobImageUrls( doc.content?.blocks ?? [], { pdsUrl, did } );
			html = sanitizeArticleHtml( renderBlocks( blocks ) );
			const textContent = doc.textContent || blocksToText( blocks );

			title = doc.title ?? 'Untitled';
			description = doc.description || textContent.slice( 0, 200 );
			canonical = canonicalArticleUrl( handle, slug!, rkey! );
			docUri = `at://${ did }/site.standard.document/${ rkey }`;
			pubUrl = `/${ author }/${ slug }`;
			feedHref = `${ pubUrl }/rss.xml`;

			const words = textContent.split( /\s+/ ).filter( Boolean ).length;
			readingMinutes = Math.max( 1, Math.round( words / 200 ) );
			publishedLabel = doc.publishedAt ? doc.publishedAt.slice( 0, 10 ) : null;
			updatedLabel = doc.updatedAt ? doc.updatedAt.slice( 0, 10 ) : null;
			themeStyle = themeStyleBlock( publication.basicTheme );

			// Share image: the publication logo, else the shared default. Only the
			// default image has known 1200x630 dimensions; a square logo omits them.
			ogImage = publication.icon
				? buildGetBlobUrl( pdsUrl, did, publication.icon.ref.$link )
				: new URL( '/og-default.png', Astro.site ).href;
			const ogDimensions = publication.icon
				? {}
				: { imageWidth: 1200, imageHeight: 630 };
			metaTags = buildMetaTags( {
				title,
				description,
				url: canonical,
				image: ogImage,
				siteName: 'SkyPress',
				type: 'article',
				imageAlt: publication.name,
				...ogDimensions,
			} );
		}
	}
}

if ( error ) {
	Astro.response.status = error.status;
}
---

{
	error ? (
		<ErrorScene eyebrow={error.eyebrow} heading={error.heading} subline={error.subline} />
	) : (
		<Base title={`${ title } — ${ publication!.name }`} description={description} socialMeta={false}>
	<Fragment slot="head">
		{/* standard.site indexing tags (brief §3) — Bluesky cards + AppView pickup */}
		<link rel="site.standard.document" href={docUri} />
		<link rel="site.standard.publication" href={publication!.uri} />
		<link rel="alternate" type="application/rss+xml" title={`${ publication!.name } — RSS`} href={feedHref} />
		<link rel="canonical" href={canonical} />
		{metaTags.map( ( tag ) =>
			tag.property ? (
				<meta property={tag.property} content={tag.content} />
			) : (
				<meta name={tag.name} content={tag.content} />
			)
		)}
		{themeStyle && <Fragment set:html={themeStyle} />}
	</Fragment>

	<header class="masthead">
		<a href="/"><Logo /></a>
	</header>
	<main class="reader">
		<p class="reader__meta eyebrow">
			<a class="reader__author" href={pubUrl}>{publication!.name}</a>
			{publishedLabel && <> · {publishedLabel}</>}
			{updatedLabel && <> · updated {updatedLabel}</>}
			· {readingMinutes} min read
		</p>
		<h1 class="reader__title">{title}</h1>
		<article class="reader__article" set:html={html} />
		<footer class="reader__foot">
			<a class="reader__author" href={pubUrl}>More from {publication!.name}</a>
		</footer>
	</main>
		</Base>
	)
}

<style>
	.masthead {
		padding: 1.5rem clamp(1.25rem, 5vw, 4rem);
		border-bottom: 1px solid var(--line);
	}
	.masthead a {
		text-decoration: none;
	}
	.reader {
		max-width: 40rem;
		margin: 0 auto;
		padding: clamp(2.5rem, 6vw, 4.5rem) 1.5rem 6rem;
	}
	.reader__meta {
		margin-bottom: 1.25rem;
	}
	.reader__author {
		color: var(--sun);
		text-decoration: none;
	}
	.reader__title {
		font-size: clamp(2.2rem, 5.5vw, 3.4rem);
		line-height: 1.04;
		margin: 0 0 2.25rem;
	}
	.reader__article {
		font-family: var(--font-body);
		font-size: 1.22rem;
		line-height: 1.72;
		color: var(--ink);
	}
	.reader__article :global(h2),
	.reader__article :global(h3) {
		margin: 2.4rem 0 0.8rem;
	}
	.reader__article :global(h2) {
		font-size: 1.7rem;
	}
	.reader__article :global(p) {
		margin: 1.2rem 0;
	}
	.reader__article :global(a) {
		color: var(--sun);
	}
	/* First paragraph: a quiet editorial lead-in */
	.reader__article :global(p:first-of-type) {
		font-size: 1.32rem;
		color: var(--ink-soft);
	}
	.reader__article :global(blockquote) {
		margin: 1.8rem 0;
		padding-left: 1.25rem;
		border-left: 3px solid var(--sun);
		font-style: italic;
		color: var(--ink-soft);
	}
	.reader__article :global(img) {
		max-width: 100%;
		height: auto;
		border-radius: var(--radius);
		box-shadow: var(--shadow);
	}
	.reader__article :global(pre) {
		background: var(--ink);
		color: var(--paper);
		font-family: var(--font-mono);
		padding: 1.1rem 1.25rem;
		border-radius: var(--radius);
		overflow: auto;
		font-size: 0.92rem;
		line-height: 1.5;
	}
	.reader__article :global(code) {
		font-family: var(--font-mono);
	}
	.reader__foot {
		margin-top: 3.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--line);
	}
</style>
