---
interface Props {
	size?: number;
	wordmark?: boolean;
}
const { size = 28, wordmark = true } = Astro.props;
---

<span class="logo">
	<svg
		class="logo__mark"
		width={size}
		height={size}
		viewBox="0 0 32 32"
		fill="none"
		aria-hidden="true"
	>
		<!-- the type block / page -->
		<rect x="2.5" y="2.5" width="27" height="27" rx="7.5" stroke="currentColor" stroke-width="2.2" />
		<!-- sun over the horizon (sky) -->
		<circle cx="16" cy="12.5" r="3.4" fill="currentColor" />
		<path d="M7 18.5h18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
		<!-- lines of set type (press) -->
		<path d="M9 22.8h14M9 25.6h9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" opacity="0.55" />
	</svg>
	{wordmark && <span class="logo__word">SkyPress</span>}
</span>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		color: var(--ink);
		text-decoration: none;
	}
	.logo__mark {
		color: var(--sky);
		flex: none;
	}
	.logo__word {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.18rem;
		font-variation-settings: 'opsz' 30, 'SOFT' 50, 'WONK' 1;
		letter-spacing: -0.015em;
		color: var(--ink);
	}
</style>
